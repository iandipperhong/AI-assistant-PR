# 텔레그램 BotFather에서 받은 토큰
TELEGRAM_BOT_TOKEN=

# 봇을 쓸 수 있는 채팅 ID (쉼표로 구분). 비워두면 누구나 사용 가능하니 꼭 채우세요.
# 봇에게 /start 를 보내면 자기 chat id를 알려줍니다.
ALLOWED_CHAT_IDS=

# LLM 공급자: gemini | claude | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (나중에 교체할 때)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

DATABASE_URL=sqlite:///./data/assistant.db
TIMEZONE=Asia/Seoul

# 알림 시점 (시간 단위, 쉼표 구분)
ASSIGNMENT_REMIND_HOURS=24,3
EXAM_REMIND_HOURS=72,24
# 알림 확인 주기(초)
REMINDER_INTERVAL_SECONDS=300
