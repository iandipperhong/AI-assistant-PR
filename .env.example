# Discord Developer Portal > Applications > Bot 에서 받은 토큰
DISCORD_BOT_TOKEN=

# 슬래시 명령어를 바로 쓰고 싶은 내 서버 ID (비우면 전역 등록, 반영까지 최대 1시간)
DISCORD_GUILD_ID=

# 봇을 쓸 수 있는 디스코드 사용자 ID (쉼표로 구분). 비워두면 누구나 사용 가능하니 꼭 채우세요.
# 봇에게 /whoami 를 보내면 내 사용자 ID를 알려줍니다.
ALLOWED_USER_IDS=

# 버튼 대시보드를 고정할 채널 ID (#대시보드), 학과 공지·학사일정 알림을 올릴 채널 ID (#알림)
# 채널 우클릭 → ID 복사 (개발자 모드 필요). 비우면 그 기능은 꺼집니다.
DASHBOARD_CHANNEL_ID=
ALERT_CHANNEL_ID=
# 학과 공지 확인 주기(분), 학사일정 알림: 시작 며칠 전 / 몇 시 이후
NOTICE_CHECK_MINUTES=30
CALENDAR_REMIND_DAYS=7,1
CALENDAR_ALERT_HOUR=9

# LLM 공급자: gemini | claude | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (나중에 교체할 때)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

DATABASE_URL=sqlite:///./data/assistant.db
TIMEZONE=Asia/Seoul

# 알림 시점 (시간 단위, 쉼표 구분)
ASSIGNMENT_REMIND_HOURS=24,3
EXAM_REMIND_HOURS=72,24
# 알림 확인 주기(초)
REMINDER_INTERVAL_SECONDS=300
